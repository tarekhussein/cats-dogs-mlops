
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements-docker.txt .

RUN pip install --no-cache-dir -r requirements-docker.txt

COPY src/__init__.py src/__init__.py
COPY src/model.py src/model.py
COPY app/ app/

# Generate a synthetic checkpoint for CI testing only.
# This is NOT a trained production model.

RUN mkdir -p models && python -c "import torch; from src.model import create_model; model = create_model(pretrained=False); torch.save({'model_state_dict': model.state_dict(), 'class_to_idx': {'Cat': 0, 'Dog': 1}}, 'models/best_model.pth')"

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
